# Copy this file to .env.local. Never commit .env.local or real secrets.
# The app runs without the values below until the phase shown needs them.

# Public URL of the site (Phase 5). NEXT_PUBLIC_ values are visible in the browser.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# MongoDB Atlas (Phase 4). Server-only.
MONGODB_URI=
MONGODB_DB_NAME=mybhubaneswar_dev

# Cloudinary (Phase 4). Server-only.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
